# Copy to .env; `make run` passes it to uvicorn with --env-file.
# Every value below is the default, so an empty .env behaves the same.

# memory = single process; redis = shared state for several nodes
QUIZ_STORE=memory
QUIZ_REDIS_URL=redis://localhost:6379/0
QUIZ_REDIS_MAX_CONNECTIONS=100

QUIZ_LEADERBOARD_INTERVAL_S=0.1
QUIZ_LEADERBOARD_TOP_N=10
QUIZ_SEND_QUEUE_SIZE=64
QUIZ_RATE_LIMIT_PER_S=10
QUIZ_RATE_LIMIT_BURST=20
QUIZ_MAX_MESSAGE_BYTES=4096
QUIZ_SESSION_TTL_S=86400
QUIZ_LOG_LEVEL=INFO
